# Synology MariaDB 10 連線設定
# 請在同目錄下建立 .env 檔案，並填入你在 phpMyAdmin 使用的登入資訊

DB_HOST=192.168.1.100       # Synology NAS 的區網 IP（在 Docker 內部可填 NAS IP 或 host.docker.internal）
DB_PORT=3306                # Synology MariaDB 10 埠號（通常為 3306 或 3307）
DB_USER=root                # phpMyAdmin 登入帳號
DB_PASSWORD=your_password   # phpMyAdmin 登入密碼
DB_NAME=book_storage        # 你在 phpMyAdmin 中建立的資料庫名稱

# 應用程式設定
APP_ENV=development
APP_PORT=8000
